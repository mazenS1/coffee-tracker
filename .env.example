# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# For local dev: direct postgres connection string
# For Vercel: use a serverless pooler/transaction connection string
DATABASE_URL="postgresql://user:password@localhost:5432/coffee_tracking?schema=public"

# Optional direct connection URL used by Prisma migrations (recommended in Vercel/CI)
DIRECT_URL="postgresql://user:password@localhost:5432/coffee_tracking?schema=public"

# Optional: maximum number of pg connections per serverless instance
PG_POOL_MAX=5

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=3000
CLIENT_URL=http://localhost:5174

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# -----------------------------------------------------------------------------
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
# Navigate to API Keys to find your keys

# Publishable Key (safe to expose to frontend)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret Key (keep this private - server-side only)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Signing Secret
# Get this from Clerk Dashboard > Webhooks > Your Endpoint > Signing Secret
# Required for verifying webhook signatures
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ROASTER ACCESS
# -----------------------------------------------------------------------------
# Comma-separated list of admin emails (or Clerk IDs) allowed to manage default roasters
ROASTER_ADMIN_EMAILS=
ROASTER_ADMIN_CLERK_IDS=
