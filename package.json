{
  "name": "coffee-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
    "scripts": {
      "build": "npm run build:shared && npm run build:server && npm run build:client",
      "build:shared": "npm run build -w @coffee-tracker/shared",
      "build:server": "npm run build -w coffee-tracking-backend",
      "build:client": "npm run build -w coffee-tracking",
      "dev:server": "npm run dev -w coffee-tracking-backend",
      "dev:client": "npm run dev -w coffee-tracking",
      "dev": "npm run dev:server & npm run dev:client",
      "lint": "npm run lint -w coffee-tracking",
      "db:migrate": "npm run -w coffee-tracking-backend prisma migrate dev",
      "db:generate": "npm run -w coffee-tracking-backend prisma generate"
    }
  }
